@page
@model Vshop.IdentityServer.Pages.Login.Index
@{ ViewData["AuthPage"] = true; ViewData["Title"] = "Entrar"; }

<section class="auth-shell" aria-labelledby="auth-title">
    <div class="auth-card">
        <header class="auth-header">
            <img class="auth-logo" src="~/images/vshop2.jpg" alt="VShop" />
            <h1 id="auth-title">Bem-vindo de volta!</h1>
            <p>Acesse sua conta para continuar suas compras.</p>
        </header>
        <partial name="_ValidationSummary" />
        @if (Model.View.EnableLocalLogin)
        {
            <form asp-page="/Account/Login/Index" class="auth-form">
                <input type="hidden" asp-for="Input.ReturnUrl" />
                <div class="auth-field">
                    <label asp-for="Input.Username">Nome de usuário</label>
                    <input class="form-control" asp-for="Input.Username" placeholder="Digite seu usuário" autocomplete="username" autofocus />
                </div>
                <div class="auth-field">
                    <label asp-for="Input.Password">Senha</label>
                    <input class="form-control" type="password" asp-for="Input.Password" placeholder="Digite sua senha" autocomplete="current-password" />
                </div>
                @if (Model.View.AllowRememberLogin)
                {
                    <div class="form-check auth-remember">
                        <input class="form-check-input" asp-for="Input.RememberLogin" />
                        <label class="form-check-label" asp-for="Input.RememberLogin">Manter minha sessão</label>
                    </div>
                }
                <button class="btn auth-primary" name="Input.Button" value="login">Entrar</button>
                <button class="btn auth-secondary" name="Input.Button" value="cancel">Cancelar</button>
            </form>
            <p class="auth-switch">Ainda não tem conta? <a asp-page="/Account/Create/Index" asp-route-returnUrl="@Model.Input.ReturnUrl">Criar conta</a></p>
        }
        @if (Model.View.VisibleExternalProviders.Any())
        {
            <div class="auth-external">
                <h2>Outras opções de acesso</h2>
                @foreach (var provider in Model.View.VisibleExternalProviders)
                {
                    <a class="btn auth-secondary" asp-page="/ExternalLogin/Challenge" asp-route-scheme="@provider.AuthenticationScheme" asp-route-returnUrl="@Model.Input.ReturnUrl">@provider.DisplayName</a>
                }
            </div>
        }
        @if (!Model.View.EnableLocalLogin && !Model.View.VisibleExternalProviders.Any())
        {
            <div class="alert alert-warning" role="alert">Não há opções de login disponíveis para esta solicitação.</div>
        }
    </div>
</section>
