@model VShop.Web.Models.CartViewModel
@{ ViewData["Title"] = "Checkout"; }
<style>
    .checkout-validation .field-validation-valid,
    .checkout-validation .validation-summary-valid { display: none; }
    .checkout-validation .field-validation-error,
    .checkout-validation .validation-summary-errors { display: block; }
</style>
<div class="container py-4 checkout-validation">
    <h2>Finalizar compra</h2>
    <div class="alert alert-info">Checkout demonstrativo: nenhum pagamento será processado e o carrinho não será consumido.</div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-4">
        <div class="col-md-7"><form asp-action="Checkout" method="post" class="card shadow-sm checkout-validation" onsubmit="this.classList.add('submitted'); if (!$(this).valid()) { this.classList.remove('submitted'); return false; } this.querySelector('button[type=submit]').disabled=true;"><div class="card-body">
            @Html.AntiForgeryToken()<h5>Dados do cliente</h5>
            <div class="row"><div class="col-md-6 mb-3"><label asp-for="CartHeader.FirstName" class="form-label">Nome</label><input asp-for="CartHeader.FirstName" class="form-control" /><span asp-validation-for="CartHeader.FirstName" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="CartHeader.LastName" class="form-label">Sobrenome</label><input asp-for="CartHeader.LastName" class="form-control" /><span asp-validation-for="CartHeader.LastName" class="text-danger"></span></div></div>
            <div class="mb-3"><label asp-for="CartHeader.Email" class="form-label">E-mail</label><input asp-for="CartHeader.Email" class="form-control" /><span asp-validation-for="CartHeader.Email" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="CartHeader.Telephone" class="form-label">Telefone</label><input asp-for="CartHeader.Telephone" class="form-control" /><span asp-validation-for="CartHeader.Telephone" class="text-danger"></span></div>
            <button type="submit" class="btn btn-primary">Confirmar checkout demonstrativo</button>
        </div></form></div>
        <div class="col-md-5"><div class="card shadow-sm"><div class="card-body"><h5>Resumo</h5>
            @foreach (var item in Model.CartItems.Where(i => i.Product != null)) { <div class="d-flex justify-content-between border-bottom py-2"><span>@item.Product!.Name (x@(item.Quantity))</span><span>@((Convert.ToDecimal(item.Product.Price) * item.Quantity).ToString("C"))</span></div> }
            <div class="mt-3">Subtotal: <strong>@Model.CartHeader.SubtotalAmount.ToString("C")</strong></div>
            @if (!string.IsNullOrWhiteSpace(Model.CartHeader.CouponCode)) { <div class="text-muted">Cupom: @Model.CartHeader.CouponCode</div><div class="text-success">Desconto: -@Model.CartHeader.DiscountAmount.ToString("C")</div> }
            <div class="fs-4 text-danger mt-2">Total: @Model.CartHeader.TotalAmount.ToString("C")</div>
        </div></div></div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
