<ul class="navbar-nav flex-row gap-3">

    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">
            <a class="nav-link" href="#">
                Olá, @User.Identity.Name
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link"
               asp-action="Logout"
               asp-controller="Home">
                Logout
            </a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link"
               asp-action="Login"
               asp-controller="Home">
                Login
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Home" asp-action="CreateAccount">Criar conta</a>
        </li>
    }

</ul>